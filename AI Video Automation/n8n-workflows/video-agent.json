      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.youtube_status }}",
              "value2": "success"
            },
            {
              "value1": "={{ $json.instagram_status }}",
              "value2": "success"
            }
          ]
        }
      },
      "id": "node-34-if-publishing-success",
