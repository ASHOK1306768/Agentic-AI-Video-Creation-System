            {
              "value1": "={{ $json.status }}",
              "value2": "PASS"
            }
          ]
        }
      },
      "id": "node-22-pass-fail",
      "name": "IF — PASS / FAIL",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
