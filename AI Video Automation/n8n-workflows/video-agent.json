      "parameters": {
        "jsCode": "return [{\n  json: {\n    youtube_status: 'success',\n    youtube_url: 'https://youtube.com/shorts/demo-video-id',\n    instagram_status: 'success',\n    instagram_url: 'https://instagram.com/reel/demo-post-id',\n    video_title: $('SEO Agent').first().json.youtube_title,\n    caption: $('SEO Agent').first().json.instagram_caption,\n    upload_time: new Date().toISOString()\n  }\n}];"
      },
