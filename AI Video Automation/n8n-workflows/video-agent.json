{
  "name": "Agentic AI Social Media Video Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-1-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "user_prompt",
              "value": "={{ $json.body.topic || $json.body.prompt || 'Create a 60-second Instagram Reel about Artificial Intelligence in Education' }}"
            },
            {
              "name": "publish_time",
              "value": "={{ $json.body.publish_time || '19:00' }}"
            },
            {
              "name": "publish_date",
              "value": "={{ $json.body.publish_date || '2026-09-25' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-2-edit-fields",
      "name": "Edit Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-worker:5000/plan",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": \"{{ $json.user_prompt }}\"\n}",
        "options": {}
      },
      "id": "node-3-planning-agent",
      "name": "Planning Agent — Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "jsCode": "const plan = $input.first().json;\nreturn [{\n  json: {\n    topic: plan.topic || 'Artificial Intelligence in Education',\n    target_audience: plan.target_audience || 'College Students',\n    platform: plan.platform || 'Instagram Reels',\n    duration: plan.duration || 60,\n    tone: plan.tone || 'Educational and Engaging',\n    style: plan.style || 'Short-form Video',\n    main_message: plan.main_message || 'AI is transforming education',\n    hook_strategy: plan.hook_strategy || 'Ask an interesting question'\n  }\n}];"
      },
      "id": "node-4-parse-planning-json",
      "name": "Code — Parse Planning JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-worker:5000/script",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": \"{{ $json.topic }}\",\n  \"duration\": {{ $json.duration }}\n}",
        "options": {}
      },
      "id": "node-5-script-agent",
      "name": "Script Agent — Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "topic",
              "value": "={{ $('Code — Parse Planning JSON').first().json.topic }}"
            },
            {
              "name": "script",
              "value": "={{ $json.script }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-6-save-script",
      "name": "Edit Fields — Save Script",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-worker:5000/scenes",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"script\": \"{{ $json.script }}\"\n}",
        "options": {}
      },
      "id": "node-7-scene-agent",
      "name": "Scene Agent — Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "jsCode": "const scenes = $input.first().json.scenes || [];\nreturn scenes.map(scene => ({ json: scene }));"
      },
      "id": "node-8-split-scenes",
      "name": "Code — Split Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "node-9-loop-over-items",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1700, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "visual_prompt",
              "value": "Professional cinematic vertical shot of {{ $json.search_keywords }}, 9:16 vertical orientation, high detail"
            }
          ]
        },
        "options": {}
      },
      "id": "node-10-visual-agent",
      "name": "Visual Agent — Ollama",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1900, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-worker:5000/visuals",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"scenes\": [ {{ JSON.stringify($json) }} ]\n}",
        "options": {}
      },
      "id": "node-11-get-visual",
      "name": "HTTP Request — Get Visual",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2100, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "visual_file",
              "value": "=/files/visuals/scene_{{ $json.visuals[0].scene_id }}.jpg"
            }
          ]
        },
        "options": {}
      },
      "id": "node-12-download-visual",
      "name": "Download / Save Visual",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [2300, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "full_script",
              "value": "={{ $('Edit Fields — Save Script').first().json.script }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-13-prepare-script",
      "name": "Prepare Complete Script",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [2000, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-worker:5000/voice",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"script\": \"{{ $json.full_script }}\"\n}",
        "options": {}
      },
      "id": "node-14-tts",
      "name": "Text-to-Speech",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2200, 450]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "audio_path",
              "value": "={{ $json.audio_path || '/files/audio/voiceover.mp3' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-15-save-audio",
      "name": "Save Audio",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [2400, 450]
    },
    {
      "parameters": {
        "jsCode": "const audio = $input.first().json.audio_path;\nreturn [{\n  json: {\n    transcription: $('Edit Fields — Save Script').first().json.script,\n    audio_path: audio\n  }\n}];"
      },
      "id": "node-16-whisper",
      "name": "Whisper",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2600, 450]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "subtitles_file",
              "value": "/files/subtitles/captions.srt"
            }
          ]
        },
        "options": {}
      },
      "id": "node-17-generate-captions",
      "name": "Generate Captions",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [2800, 450]
    },
    {
      "parameters": {
        "jsCode": "const script = $('Edit Fields — Save Script').first().json.script;\nconst scenes = $('Scene Agent — Ollama').first().json.scenes || [];\nconst audio = $('Save Audio').first().json.audio_path;\nconst title = $('Edit Fields — Save Script').first().json.topic;\nreturn [{\n  json: {\n    script,\n    scenes,\n    audio_path: audio,\n    title: title || 'final_video'\n  }\n}];"
      },
      "id": "node-18-prepare-video-files",
      "name": "Prepare Video Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3000, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-worker:5000/compose",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"scenes\": {{ JSON.stringify($json.scenes) }},\n  \"audio_path\": \"{{ $json.audio_path }}\",\n  \"title\": \"{{ $json.title }}\"\n}",
        "options": {}
      },
      "id": "node-19-ffmpeg",
      "name": "FFmpeg",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [3200, 350]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.video_path }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "node-20-check-files",
      "name": "IF — Check Files",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [3400, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-worker:5000/qc",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"script\": \"{{ $('Edit Fields — Save Script').first().json.script }}\",\n  \"scenes\": {{ JSON.stringify($('Scene Agent — Ollama').first().json.scenes || []) }},\n  \"audio_path\": \"{{ $('Save Audio').first().json.audio_path }}\",\n  \"video_path\": \"{{ $json.video_path }}\"\n}",
        "options": {}
      },
      "id": "node-21-quality-agent",
      "name": "Quality Control Agent",
